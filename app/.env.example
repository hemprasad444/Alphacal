# Copy to .env. With nothing set, the app runs as an on-device demo.

# Firebase: console → Project settings → Your apps → Web app → config.
# These identify the project and are safe to ship; access is enforced by sign-in and rules.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Local development against `npm run emulators` instead of the real project:
# the LAN IP of the computer running the emulators (your phone must reach it).
# EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=192.168.1.20
