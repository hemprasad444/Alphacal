# Copy to .env and set ONE of these. With neither, REI runs on built-in offline replies.

# Your own proxy that forwards POST /v1/messages to the Claude API and adds the key
# server-side. Use this for any build you install on someone else's phone.
# EXPO_PUBLIC_REI_API_URL=https://your-proxy.example.com

# Local development only: the key is bundled into the app and can be extracted from it.
# EXPO_PUBLIC_ANTHROPIC_API_KEY=sk-ant-...
