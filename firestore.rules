rules_version = '2';

// REI: each tester reads and writes only their own data under users/{uid}.
// Testers are invited by adding allowlist/{lowercased email} (console or admin script).
// Cloud Functions use the Admin SDK and bypass these rules.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email is string;
    }
    function email() {
      return request.auth.token.email.lower();
    }
    // The `tester` claim (set by the activate function) avoids a document read per request;
    // the allowlist lookup covers the moments before the claim is issued.
    function tester() {
      return signedIn()
        && (request.auth.token.tester == true || exists(/databases/$(database)/documents/allowlist/$(email())));
    }
    function owner(uid) {
      return tester() && request.auth.uid == uid;
    }
    function num(v, max) {
      return v is number && v >= 0 && v <= max;
    }
    function validFood(f) {
      return f.name is string && f.name.size() > 0 && f.name.size() <= 80
        && num(f.per, 5000) && f.per > 0 && num(f.kcal, 10000) && num(f.p, 1000) && num(f.c, 2000) && num(f.f, 1000)
        && f.units is list && f.units.size() >= 1 && f.units.size() <= 6;
    }
    function isoDate(id) {
      return id.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    match /allowlist/{address} {
      allow get: if signedIn() && address == email();
      allow list, write: if false;
    }

    match /users/{uid} {
      allow get, create, update: if owner(uid);
      allow list, delete: if false;

      match /days/{day} {
        allow read: if owner(uid);
        allow create, update: if owner(uid) && isoDate(day)
          && (!('meals' in request.resource.data) || request.resource.data.meals.size() <= 40);
        allow delete: if false;
      }

      match /messages/{id} {
        allow read: if owner(uid);
        allow create: if owner(uid)
          && request.resource.data.role in ['user', 'rei', 'sys']
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 4000
          && request.resource.data.createdAt is number;
        allow update, delete: if false;
      }

      match /sessions/{id} {
        allow read, create: if owner(uid);
        allow update, delete: if false;
      }

      // Your own foods: saved meals, scanned products, corrected numbers.
      match /foods/{id} {
        allow read, delete: if owner(uid);
        allow create, update: if owner(uid) && id.size() <= 42 && validFood(request.resource.data);
      }

      match /weighIns/{day} {
        allow read: if owner(uid);
        allow create, update: if owner(uid) && isoDate(day) && request.resource.data.kg is number;
        allow delete: if false;
      }

      // Written only by Cloud Functions.
      match /programs/{week} {
        allow read: if owner(uid);
        allow write: if false;
      }
      match /usage/{doc} {
        allow read: if owner(uid);
        allow write: if false;
      }
    }
  }
}
